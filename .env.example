# NexCoder Environment Configuration
# Copy this to .env and fill in your values.

# Production NexCoder model API
NEXA_API_URL=https://nexcoder.trynexa-ai.com/v1
NEXA_MODEL=default
# Private-beta credential issued by Nexa Labs. Never commit real keys.
NEXA_API_KEY=
# The hosted NexCoder GGUF model uses the XML tool transport.
NEXCODER_ADAPTER=xml

# Optional OpenAI-compatible sampling and reasoning controls. Leave unset for
# providers that do not support them.
# NEXCODER_TOP_P=0.9
# NEXCODER_REASONING_MODELS=nvidia/nemotron-3-ultra-550b-a55b
# NEXCODER_ENABLE_THINKING=1
# NEXCODER_FORCE_NONEMPTY_CONTENT=1
# NEXCODER_REASONING_EFFORT=high
# NEXCODER_REASONING_BUDGET=4096
# NEXCODER_RESERVE_OUTPUT=16384
# NEXA_CONTEXT_WINDOW=65536

# Server-side development override (production clients do not need this):
# NEXA_API_URL=http://127.0.0.1:8002/v1

# NexCoder Web auth origin. The desktop app defaults to the production web
# login at https://nexcoder.trynexa-ai.com; override only for local web dev.
NEXCODER_WEB_URL=https://nexcoder.trynexa-ai.com

# GGUF server options used only when developing the model server locally
NEXCODER_GGUF_CTX=32768
NEXCODER_GGUF_GPU_LAYERS=-1
NEXCODER_GGUF_CHAT_FORMAT=chatml

# Appwrite Configuration
APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_project_id_here
APPWRITE_DATABASE_ID=your_database_id_here

# Agent commands redact secret-like environment variables by default.
# Opt in only the names a trusted project command explicitly needs.
NEXCODER_COMMAND_ENV_ALLOW=

